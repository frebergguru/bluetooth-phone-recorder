msgid "No USB Bluetooth adapters found."
msgstr "Fant ingen USB-Bluetooth-adaptere."

msgid "Usage: %s [options]\n\n  --adapter=ID        use this adapter (see --list-adapters), for this run only\n  --list-adapters     list Bluetooth adapters and exit\n  --release-adapters  give adapters left without a driver back to the system\n  --trace             save a Bluetooth trace (PacketLogger format)\n  --verbose           more log output\n  --version           show the version\n"
msgstr "Bruk: %s [valg]\n\n  --adapter=ID        bruk denne adapteren (se --list-adapters), bare denne gangen\n  --list-adapters     vis Bluetooth-adaptere og avslutt\n  --release-adapters  gi adaptere uten driver tilbake til systemet\n  --trace             lagre et Bluetooth-spor (PacketLogger-format)\n  --verbose           mer loggutskrift\n  --version           vis versjonen\n"

msgid "%d adapter(s) given back to the system.\n"
msgstr "%d adapter(e) gitt tilbake til systemet.\n"

msgid "Cannot create the recording folder %s"
msgstr "Kan ikke lage opptaksmappen %s"

msgid "Recording could not start: %s"
msgstr "Opptaket kunne ikke starte: %s"

msgid "Recording started"
msgstr "Opptaket startet"

msgid "Recording saved in %s"
msgstr "Opptaket er lagret i %s"

msgid "Open folder"
msgstr "Åpne mappen"

msgid "Recording stopped and saved"
msgstr "Opptaket er stoppet og lagret"

msgid "Markers can only be added while recording"
msgstr "Markører kan bare legges til under opptak"

msgid "Marker %d"
msgstr "Markør %d"

msgid "%s added at %02d:%02d:%02d"
msgstr "%s lagt til ved %02d:%02d:%02d"

msgid "unknown number"
msgstr "ukjent nummer"

msgid "Incoming call from %s"
msgstr "Innkommende anrop fra %s"

msgid "Incoming call"
msgstr "Innkommende anrop"

msgid "Answer"
msgstr "Svar"

msgid "Call connected"
msgstr "Samtalen er koblet til"

msgid "Call ended"
msgstr "Samtalen er avsluttet"

msgid "Starting %s"
msgstr "Starter %s"

msgid "Ready, %s (%s)"
msgstr "Klar, %s (%s)"

msgid "Adapter failed: %s"
msgstr "Adapteren feilet: %s"

msgid "Bluetooth off"
msgstr "Bluetooth er av"

msgid "Phone paired"
msgstr "Telefonen er paret"

msgid "Pairing failed. Try again from the phone's Bluetooth settings."
msgstr "Paringen mislyktes. Prøv igjen fra Bluetooth-innstillingene på telefonen."

msgid "%s connected"
msgstr "%s er tilkoblet"

msgid "%s disconnected"
msgstr "%s er frakoblet"

msgid "Phone"
msgstr "Telefon"

msgid "No call audio arrives through the kernel driver mode. This adapter may need the direct USB mode for call audio (Choose adapter)."
msgstr "Det kommer ingen samtalelyd i kjernedriver-modus. Denne adapteren trenger kanskje direkte USB-modus for samtalelyd (Velg adapter)."

msgid "The call is connected, but no audio arrives from the adapter. Save an adapter report and try another adapter or mode."
msgstr "Samtalen er koblet til, men det kommer ingen lyd fra adapteren. Lagre en adapterrapport og prøv en annen adapter eller modus."

msgid "Free space: %.1f GB (about %.0f hours)"
msgstr "Ledig plass: %.1f GB (omtrent %.0f timer)"

msgid "Warning: less than 15 minutes of recording space left"
msgstr "Advarsel: mindre enn 15 minutter opptaksplass igjen"

msgid "Audio: no dropouts"
msgstr "Lyd: ingen utfall"

msgid "Audio: %llu dropouts, %llu damaged phone packets repaired"
msgstr "Lyd: %llu utfall, %llu skadde telefonpakker reparert"

msgid "Mic %d"
msgstr "Mikrofon %d"

msgid "Audio system unavailable"
msgstr "Lydsystemet er utilgjengelig"

msgid "PipeWire could not be used: %s"
msgstr "PipeWire kunne ikke brukes: %s"

msgid "Close"
msgstr "Lukk"

msgid "No Bluetooth adapter chosen"
msgstr "Ingen Bluetooth-adapter er valgt"

msgid "Adapter %s not found"
msgstr "Fant ikke adapteren %s"

msgid "The chosen Bluetooth adapter was not found. Plug it in or choose another."
msgstr "Fant ikke den valgte Bluetooth-adapteren. Koble den til eller velg en annen."

msgid "OBS: %s"
msgstr "OBS: %s"

msgid "Connected to OBS"
msgstr "Koblet til OBS"

msgid "Pair with this phone?"
msgstr "Pare med denne telefonen?"

msgid "Check that the phone shows the code %s, then choose Pair on both the phone and here.\n\nPhone address: %s"
msgstr "Sjekk at telefonen viser koden %s, og velg Par både på telefonen og her.\n\nTelefonadresse: %s"

msgid "_Cancel"
msgstr "_Avbryt"

msgid "_Pair"
msgstr "_Par"

msgid "Pairing request, code %s"
msgstr "Paringsforespørsel, kode %s"

msgid "Enter a PIN"
msgstr "Skriv inn en PIN-kode"

msgid "This older phone asks for a PIN. Type the same PIN here and on the phone, for example 0000."
msgstr "Denne eldre telefonen ber om en PIN-kode. Skriv den samme koden her og på telefonen, for eksempel 0000."

msgid "PIN"
msgstr "PIN-kode"

msgid "Restarting to use the new adapter..."
msgstr "Starter på nytt for å bruke den nye adapteren ..."

msgid "Enter the serial port, for example /dev/ttyUSB0"
msgstr "Skriv inn serieporten, for eksempel /dev/ttyUSB0"

msgid "The kernel driver mode needs the adapter to be enabled in the system first (it has no hci device right now)."
msgstr "Kjernedriver-modus krever at adapteren først er slått på i systemet (den har ingen hci-enhet nå)."

msgid "Take over this adapter?"
msgstr "Ta over denne adapteren?"

msgid "The system uses this adapter now. While Phone Recorder runs, other Bluetooth devices on it (headphones, mouse, keyboard) will disconnect. They work again when Phone Recorder closes. A separate USB Bluetooth dongle avoids this."
msgstr "Systemet bruker denne adapteren nå. Mens Telefonopptak kjører, blir andre Bluetooth-enheter på den (hodetelefoner, mus, tastatur) koblet fra. De virker igjen når Telefonopptak lukkes. En egen USB-Bluetooth-dongle unngår dette."

msgid "_Use it"
msgstr "_Bruk den"

msgid "Choose an adapter first"
msgstr "Velg en adapter først"

msgid "%s chip, USB %04x:%04x at %s. %s"
msgstr "%s-brikke, USB %04x:%04x på %s. %s"

msgid "In use by the system now."
msgstr "Brukes av systemet nå."

msgid "Free, not used by the system."
msgstr "Ledig, brukes ikke av systemet."

msgid "Mode"
msgstr "Modus"

msgid "Direct USB (recommended)"
msgstr "Direkte USB (anbefalt)"

msgid "Kernel driver, raw access"
msgstr "Kjernedriver, rå tilgang"

msgid "Direct USB: the app talks to the adapter itself. Kernel driver: the system loads the firmware, the app gets exclusive raw access (needs the helper)."
msgstr "Direkte USB: appen snakker med adapteren selv. Kjernedriver: systemet laster fastvaren, og appen får eksklusiv rå tilgang (krever hjelpeprogrammet)."

msgid "This chip needs firmware that only the kernel driver can load, so use the kernel driver mode (needs the helper, see README)."
msgstr "Denne brikken trenger fastvare som bare kjernedriveren kan laste, så bruk kjernedriver-modus (krever hjelpeprogrammet, se README)."

msgid "No USB Bluetooth adapter found"
msgstr "Fant ingen USB-Bluetooth-adapter"

msgid "Plug in a USB Bluetooth dongle and choose Refresh."
msgstr "Koble til en USB-Bluetooth-dongle og velg Oppdater."

msgid "Choose Bluetooth adapter"
msgstr "Velg Bluetooth-adapter"

msgid "Search again"
msgstr "Søk igjen"

msgid "Refresh"
msgstr "Oppdater"

msgid "Welcome! Phone Recorder connects to your phone like a car kit. Choose the Bluetooth adapter it should use. A separate USB dongle is best, so your other Bluetooth devices keep working."
msgstr "Velkommen! Telefonopptak kobler seg til telefonen din som et bilsett. Velg Bluetooth-adapteren den skal bruke. En egen USB-dongle er best, så de andre Bluetooth-enhetene dine fortsetter å virke."

msgid "The app restarts to switch adapters."
msgstr "Appen starter på nytt for å bytte adapter."

msgid "USB adapters"
msgstr "USB-adaptere"

msgid "Serial (UART) adapter"
msgstr "Serieadapter (UART)"

msgid "Use a serial adapter"
msgstr "Bruk en serieadapter"

msgid "For Bluetooth modules on a serial port (advanced)"
msgstr "For Bluetooth-moduler på en serieport (avansert)"

msgid "Serial port"
msgstr "Serieport"

msgid "Speed (baud)"
msgstr "Hastighet (baud)"

msgid "Three-wire protocol (H5)"
msgstr "Trelederprotokoll (H5)"

msgid "Hardware flow control"
msgstr "Maskinvare-flytkontroll"

msgid "_Use this adapter"
msgstr "_Bruk denne adapteren"

msgid "Adapter report saved"
msgstr "Adapterrapporten er lagret"

msgid "Save adapter report"
msgstr "Lagre adapterrapport"

msgid "Recording folder"
msgstr "Opptaksmappe"

msgid "Preferences"
msgstr "Innstillinger"

msgid "Recording"
msgstr "Opptak"

msgid "_Change..."
msgstr "_Endre ..."

msgid "File format"
msgstr "Filformat"

msgid "WAV, 32-bit float (best for editing)"
msgstr "WAV, 32-biters flyttall (best for redigering)"

msgid "WAV, 24-bit"
msgstr "WAV, 24-biters"

msgid "FLAC, 24-bit (lossless, smaller)"
msgstr "FLAC, 24-biters (tapsfri, mindre)"

msgid "Opus (small, for quick sharing)"
msgstr "Opus (liten, for rask deling)"

msgid "Start recording when a call starts"
msgstr "Start opptak når en samtale starter"

msgid "Stop automatic recordings when the call ends"
msgstr "Stopp automatiske opptak når samtalen slutter"

msgid "Audio"
msgstr "Lyd"

msgid "Protect the full mix from clipping"
msgstr "Beskytt hovedmiksen mot klipping"

msgid "A gentle peak limiter at -1 dB on the stereo mix. Single-input tracks are never limited."
msgstr "En mild toppbegrenser på -1 dB på stereomiksen. Spor for enkeltinnganger begrenses aldri."

msgid "Bluetooth"
msgstr "Bluetooth"

msgid "HD voice (mSBC, 16 kHz)"
msgstr "HD-tale (mSBC, 16 kHz)"

msgid "Super wideband (LC3-SWB, 32 kHz)"
msgstr "Superbredbånd (LC3-SWB, 32 kHz)"

msgid "Used when the phone supports it"
msgstr "Brukes når telefonen støtter det"

msgid "Ask the phone to skip its own noise reduction"
msgstr "Be telefonen hoppe over sin egen støydemping"

msgid "Your microphones are already clean, so the caller hears you more naturally"
msgstr "Mikrofonene dine er allerede rene, så den som ringer hører deg mer naturlig"

msgid "Secure Connections"
msgstr "Sikre tilkoblinger (Secure Connections)"

msgid "Turn off only if pairing or call audio fails with an older adapter"
msgstr "Slå av bare hvis paring eller samtalelyd feiler med en eldre adapter"

msgid "Extra firmware folder (optional)"
msgstr "Ekstra fastvaremappe (valgfritt)"

msgid "Save Bluetooth trace"
msgstr "Lagre Bluetooth-spor"

msgid "For troubleshooting. Saved in ~/.local/state/bt-phone-recorder"
msgstr "For feilsøking. Lagres i ~/.local/state/bt-phone-recorder"

msgid "OBS"
msgstr "OBS"

msgid "Audio in OBS"
msgstr "Lyd i OBS"

msgid "Always available, nothing to set up here: in OBS add an \"Audio Input Capture\" source and choose \"Phone Recorder: Full mix\", \"Phone Recorder: Caller\", \"Phone Recorder: Mix-minus\" or one of your inputs. Put them on separate OBS tracks if you want to edit them separately."
msgstr "Alltid tilgjengelig, ingenting å sette opp her: legg til en kilde av typen \"Audio Input Capture\" i OBS og velg \"Phone Recorder: Full mix\", \"Phone Recorder: Caller\", \"Phone Recorder: Mix-minus\" eller en av inngangene dine. Legg dem på egne OBS-spor hvis du vil redigere dem hver for seg."

msgid "Remote control (obs-websocket)"
msgstr "Fjernstyring (obs-websocket)"

msgid "In OBS: Tools, WebSocket Server Settings. Enable it and copy the port and password here."
msgstr "I OBS: Verktøy, WebSocket-serverinnstillinger. Slå den på og kopier porten og passordet hit."

msgid "Control OBS"
msgstr "Styr OBS"

msgid "Host"
msgstr "Vert"

msgid "Port"
msgstr "Port"

msgid "Password"
msgstr "Passord"

msgid "Start and stop OBS recording together with this app"
msgstr "Start og stopp OBS-opptak sammen med denne appen"

msgid "Add markers as OBS chapters"
msgstr "Legg til markører som OBS-kapitler"

msgid "Needs OBS 30.2 or newer and a format with chapters"
msgstr "Krever OBS 30.2 eller nyere og et format med kapitler"

msgid "Connect now"
msgstr "Koble til nå"

msgid "Text size (percent)"
msgstr "Tekststørrelse (prosent)"

msgid "Also Ctrl+plus and Ctrl+minus"
msgstr "Også Ctrl+pluss og Ctrl+minus"

