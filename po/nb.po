msgstr "Avslutt"

msgid "Phone Recorder"
msgstr "Telefonopptak"

msgid "Record phone calls over Bluetooth for podcasts. Works like a car kit, with its own Bluetooth stack."
msgstr "Ta opp telefonsamtaler over Bluetooth til podkaster. Virker som et bilsett, med sin egen Bluetooth-stakk."

msgid "BTstack is free for non-commercial use only. Because Phone Recorder includes BTstack, the program as a whole may only be used and shared for non-commercial purposes. See NOTICE."
msgstr "BTstack er bare gratis for ikke-kommersiell bruk. Fordi Telefonopptak inneholder BTstack, kan programmet som helhet bare brukes og deles til ikke-kommersielle formål. Se NOTICE."

msgid "Caller"
msgstr "Innringer"

msgid "In call"
msgstr "I samtalen"

msgid "Not in call"
msgstr "Ikke i samtalen"

