msgstr "Flytt samtalelyden mellom telefon og datamaskin"

msgid "Mixer"
msgstr "Mikser"

msgid "Input 1 to 9: heard by the caller on or off"
msgstr "Inngang 1 til 9: hørbar for den som ringer, av eller på"

msgid "Input 1 to 9: mute on or off"
msgstr "Inngang 1 til 9: demping av eller på"

msgid "Add an input"
msgstr "Legg til en inngang"

msgid "General"
msgstr "Generelt"

msgid "Larger text"
msgstr "Større tekst"

msgid "Smaller text"
msgstr "Mindre tekst"

msgid "Normal text size"
msgstr "Normal tekststørrelse"

